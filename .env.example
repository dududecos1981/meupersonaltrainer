# ==============================================================================
# SISTEMA PERSONAL TRAINER & NUTRIÇÃO — VARIÁVEIS DE AMBIENTE (.env.example)
# Configuração 100% Gratuita na Nuvem (Neon DB + Vercel + GitHub + Gemini)
# ==============================================================================

NODE_ENV=development

# 1. URL da Aplicação (Local ou Vercel)
VITE_APP_URL=http://localhost:5174
NEXT_PUBLIC_APP_URL=http://localhost:5174

# 2. Banco de Dados Neon Serverless PostgreSQL (100% Gratuito - console.neon.tech)
# Copie a connection string do seu projeto no Neon:
VITE_NEON_DATABASE_URL=postgres://usuario:senha@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://usuario:senha@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Google Gemini AI (100% Gratuito - aistudio.google.com)
VITE_GEMINI_API_KEY=AIzaSySuaChaveAqui
GEMINI_API_KEY=AIzaSySuaChaveAqui

# 4. Compatibilidade Opcional (Supabase / Outros Postgres)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
