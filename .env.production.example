# ==============================================================================
# SISTEMA PERSONAL TRAINER & NUTRIÇÃO — AMBIENTE DE PRODUÇÃO (.env.production.example)
# Configure estas variáveis no painel da Vercel, Netlify, Cloudflare Pages ou Railway.
# NUNCA versione chaves reais no repositório Git!
# ==============================================================================

NODE_ENV=production

# 1. URL da Aplicação em Produção
VITE_APP_URL=https://personaltrainer.seudominio.com.br
NEXT_PUBLIC_APP_URL=https://personaltrainer.seudominio.com.br

# 2. Supabase / Neon Cloud (PostgreSQL com RLS)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.seu_anon_key_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.seu_anon_key_aqui

# Chave administrativa para Edge Functions e Migrations (Servidor / CI/CD apenas)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.seu_service_role_key

# 3. Inteligência Artificial (Google Gemini / OpenAI)
VITE_GEMINI_API_KEY=AIzaSy_sua_chave_gemini_producao
GEMINI_API_KEY=AIzaSy_sua_chave_gemini_producao
OPENAI_API_KEY=sk-proj-sua_chave_openai_se_houver

# 4. Monitoramento & Erros (Opcional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
